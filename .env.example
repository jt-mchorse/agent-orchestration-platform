# Environment variables agent-orchestration-platform reads (#151, portfolio-ops#80).
# Every one is optional for the hermetic demo and test suite; copy to `.env`
# only for the live paths below. `test/env-example.test.ts` fails if the source
# reads a variable this file does not list.

# Postgres trace backend (`src/trace/pg-store.ts`). `PgStore` connects here;
# unset or blank = the local docker-compose database below (the code's
# `DEFAULT_CONNECTION_STRING`, host port 5433), NOT an in-memory store. The
# in-memory store is the trace server's `--memory` flag.
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_trace

# Posting the eval sticky PR comment (`src/eval/comment.ts`). Read in this
# order; the first non-blank one wins.
GITHUB_TOKEN=
GH_TOKEN=

# Trace server port (`src/bin/trace-server.ts`). Default 8766; must be a
# plain integer in range, anything else is refused.
PORT=8766

# Root of a checkout of the whole portfolio, for the decision-aware planner,
# which reads each repo's MEMORY/core_decisions_ai.md (`src/io/env.ts`).
PORTFOLIO_ROOT=
